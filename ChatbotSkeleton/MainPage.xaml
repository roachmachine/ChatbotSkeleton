<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:selectors="clr-namespace:ChatbotSkeleton.Selectors"
             x:Class="ChatbotSkeleton.MainPage"
             BackgroundColor="{StaticResource Gray900}">

    <ContentPage.Resources>
        <!-- User Message Template (Right-aligned, Primary color) -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Grid Padding="8,4">
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        Padding="12,8"
                        HorizontalOptions="End"
                        MaximumWidthRequest="320">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Text}"
                           TextColor="White"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           SemanticProperties.Description="User message" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Bot Message Template (Left-aligned, Gray600 color) -->
        <DataTemplate x:Key="BotMessageTemplate">
            <Grid Padding="8,4">
                <Border BackgroundColor="{StaticResource Gray600}"
                        StrokeThickness="0"
                        Padding="12,8"
                        HorizontalOptions="Start"
                        MaximumWidthRequest="320">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Text}"
                           TextColor="White"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           SemanticProperties.Description="Assistant message" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template Selector -->
        <selectors:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
                                               UserTemplate="{StaticResource UserMessageTemplate}"
                                               BotTemplate="{StaticResource BotMessageTemplate}" />
    </ContentPage.Resources>

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" BackgroundColor="{StaticResource Gray950}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toggle Button -->
            <Button Grid.Row="0"
                    x:Name="ToggleButton"
                    Text="❮"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="OnToggleSidebar"
                    Margin="8"
                    CornerRadius="12"
                    HeightRequest="48"
                    WidthRequest="48"
                    SemanticProperties.Description="Toggle sidebar" />

            <!-- New Chat Button -->
            <Button Grid.Row="1"
                    x:Name="NewChatButton"
                    Text="+  New Chat"
                    FontSize="14"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Gray600}"
                    TextColor="White"
                    Clicked="OnNewChat"
                    Margin="8,4"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    CornerRadius="12"
                    ToolTipProperties.Text="New chat"
                    SemanticProperties.Description="Start a new chat" />

            <!-- History List -->
            <CollectionView Grid.Row="2"
                            x:Name="HistoryList"
                            ItemsSource="{Binding ChatHistory}"
                            SelectionMode="Single"
                            SelectionChanged="OnHistorySelected"
                            Margin="0,8,0,0"
                            SemanticProperties.Description="Chat history">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,4"
                                BackgroundColor="Transparent"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0"
                                       Text="💬"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       x:Name="HistoryItemLabel"
                                       Text="{Binding .}"
                                       TextColor="White"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="Chat history item" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chat Messages -->
            <CollectionView Grid.Row="0"
                            x:Name="ChatCollectionView"
                            ItemsSource="{Binding Messages}"
                            ItemTemplate="{StaticResource MessageTemplateSelector}"
                            BackgroundColor="{StaticResource Gray900}"
                            Margin="35"
                            SelectionMode="None" />

            <!-- Input Bar -->
            <Border Grid.Row="1"
                    BackgroundColor="{StaticResource Gray900}"
                    Padding="10"
                    Margin="35"
                    StrokeThickness="0"
                    VerticalOptions="End">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource Gray600}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Editor x:Name="MessageEditor"
                                Placeholder="Type a message…"
                                PlaceholderColor="{StaticResource Gray300}"
                                TextColor="White"
                                Margin="10,10,10,20"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MaximumHeightRequest="120"
                                VerticalOptions="Center" />
                    </Border>

                    <Button Grid.Column="1"
                            Text="⮝"
                            FontSize="22"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Gray600}"
                            TextColor="White"
                            CornerRadius="28"
                            WidthRequest="60"
                            HeightRequest="60"
                            Padding="0"
                            Clicked="OnSendClicked"
                            SemanticProperties.Description="Send message" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
